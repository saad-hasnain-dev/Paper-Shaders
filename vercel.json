{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build -- --base /demos/liquid-metal/",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "destination": "/demos/liquid-metal",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/demos/liquid-metal/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/demos/liquid-metal",
      "destination": "/index.html"
    },
    {
      "source": "/demos/liquid-metal/:path*",
      "destination": "/index.html"
    }
  ]
}
