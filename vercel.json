{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build -- --base /demos/liquid-metal/",
  "rewrites": [
    {
      "source": "/demos/liquid-metal/assets/:path*",
      "destination": "/assets/:path*"
    },
    { "source": "/demos/liquid-metal", "destination": "/" },
    { "source": "/demos/liquid-metal/:path*", "destination": "/" }
  ]
}
